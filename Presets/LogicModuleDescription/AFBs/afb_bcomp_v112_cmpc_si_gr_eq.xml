<AFB id="#cmpc_si_gr_eq_v1" Caption="cmpc_si_gr_eq" Version="1.1">
	<Properties>
		<Description>Comparator Block, greater or equal to 32-bit signed integer comparison with constant value</Description>
		<Category>Compare</Category>
		<OpCode>10</OpCode>
		<InternalUse>false</InternalUse>
		<MinWidth>26</MinWidth>
	</Properties>
	<Inputs>
		<Pin OpName="i_data" Caption="in" Type="Analog" ByteOrder="BigEndian" DataFormat="SignedInt" OpIndex="6" Size="32"/>
		<Pin OpName="i_sync_in" Caption="s_in" Type="Discrete" ByteOrder="BigEndian" OpIndex="5" Size="1"/>
	</Inputs>
	<Outputs>
		<Pin OpName="o_result" Caption="out" Type="Discrete" ByteOrder="BigEndian" OpIndex="9" Size="1"/>
		<Pin OpName="o_sync_out" Caption="s_out" Type="Discrete" ByteOrder="BigEndian" OpIndex="9" Size="1"/>
	</Outputs>
	<Params>
		<Param OpName="i_sp_s" Caption="SetPoint" Visible="true" OpIndex="1" Size="32" Instantiator="true" User="true" Type="Analog" ByteOrder="BigEndian" DataFormat="SignedInt">
			<Value>0</Value>
			<Default>0</Default>
			<LowLimit>-2147483648</LowLimit>
			<HighLimit>2147483647</HighLimit>
			<Script>
				<Changed/>
			</Script>
		</Param>
		<Param OpName="i_sp_r" Caption="ValueR" Visible="false" OpIndex="3" Size="32" Instantiator="true" User="false" Type="Analog" ByteOrder="BigEndian" DataFormat="SignedInt">
			<Value>0</Value>
			<Default>0</Default>
			<LowLimit>-2147483648</LowLimit>
			<HighLimit>2147483647</HighLimit>
			<Script>
				<Changed/>
			</Script>
		</Param>
		<Param OpName="hysteresis" Caption="Hysteresis" Visible="true" OpIndex="-1" Size="32" Instantiator="false" User="true" Type="Analog" ByteOrder="BigEndian" DataFormat="SignedInt">
			<Value>0</Value>
			<Default>0</Default>
			<LowLimit>0</LowLimit>
			<HighLimit>2147483647</HighLimit>
			<Script>
				<Changed/>
			</Script>
		</Param>
		<Param OpName="i_conf" Caption="Config" Visible="false" OpIndex="0" Size="16" Instantiator="true" User="false" Type="Analog" ByteOrder="BigEndian" DataFormat="UnsignedInt">
			<Value>9</Value>
			<Default>9</Default>
			<LowLimit>1</LowLimit>
			<HighLimit>12</HighLimit>
			<Script>
				<Changed/>
			</Script>
		</Param>
		<Param OpName="SyncStatePins" Caption="SyncStatePins" Visible="false" OpIndex="-1" Size="1" Instantiator="false" User="true" Type="Discrete">
			<Value>0</Value>
			<Default>0</Default>
			<Script>
				<Changed>
					(function(videoItemFblElement, afbElement)
					{
						createSyncSignals(videoItemFblElement, afbElement);
					})
				</Changed>
			</Script>
		</Param>
	</Params>
	<CommonScript>
		<Library>
			function createSyncSignals(videoItemFblElement, afbElement)
			{
				videoItemFblElement.removeInputSignal("s_in");
				videoItemFblElement.removeOutputSignal("s_out");

				var show = videoItemFblElement.getParamBoolValue("SyncStatePins");
				if (show == true)
				{
					var s = afbElement.getAfbSignalByCaption("s_in");
					if (s != null)
					{
						videoItemFblElement.addInputSignal(s.jsCaption(), s.jsType(), s.operandIndex(), s.size());
					}

					s = afbElement.getAfbSignalByCaption("s_out");
					if (s != null)
					{
						videoItemFblElement.addOutputSignal(s.jsCaption(), s.jsType(), s.operandIndex(), s.size());
					}
				}

				videoItemFblElement.adjustHeight();
				return true;
			}
		</Library>
		<AfterCreation>
			(function(videoItemFblElement, afbElement)
			{
				createSyncSignals(videoItemFblElement, afbElement);
			})
		</AfterCreation>
	</CommonScript>
</AFB>