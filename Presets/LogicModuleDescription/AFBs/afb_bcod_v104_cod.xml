<AFB id="#cod_v1" Caption="cod" Version="1.0008">
	<Properties>
		<Description>Binary Coder Block scans 32 Boolean inputs in sequence from in_32 to in_1, and sets the output, equal to the index of the last TRUE input. The output active is set TRUE if at least one input is TRUE.</Description>
		<Category>Logic</Category>
		<OpCode>8</OpCode>
		<InternalUse>false</InternalUse>
		<MinWidth>14</MinWidth>
	</Properties>
	<Inputs>
		<Pin OpName="i_1_oprd" Caption="in_1" Type="Discrete" ByteOrder="BigEndian" OpIndex="2" Size="1"/>
		<Pin OpName="i_2_oprd" Caption="in_2" Type="Discrete" ByteOrder="BigEndian" OpIndex="3" Size="1"/>
