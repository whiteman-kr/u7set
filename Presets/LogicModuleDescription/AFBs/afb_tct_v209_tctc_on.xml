<AFB id="#tctc_on_v1" Caption="tctc_on" Version="1.13">
	<Properties>
		<Description>Time Counter Block with constant time value, turn on delay function</Description>
		<Category>Delay</Category>
		<OpCode>3</OpCode>
		<InternalUse>false</InternalUse>
		<MinWidth>20</MinWidth>
		<MinHeight>8</MinHeight>
	</Properties>
	<Inputs>
		<Pin OpName="i_wave" Caption="in" Type="Discrete" ByteOrder="BigEndian" OpIndex="6" Size="1"/>
		<Pin OpName="i_sync_in" Caption="s_in" Type="Analog" ByteOrder="BigEndian" DataFormat="SignedInt" OpIndex="3" Size="32"/>
	</Inputs>
	<Outputs>
		<Pin OpName="o_result" Caption="out" Type="Discrete" ByteOrder="BigEndian" OpIndex="8" Size="1"/>
		<Pin OpName="o_sync_out" Caption="s_out" Type="Analog" ByteOrder="BigEndian" DataFormat="SignedInt" OpIndex="9" Size="32"/>
	</Outputs>
	<Params>
		<Param OpName="i_counter" Caption="Time" Visible="true" OpIndex="1" Size="32" Instantiator="true" User="true" Type="Analog" ByteOrder="BigEndian" DataFormat="UnsignedInt">
			<Value>1000</Value>
			<Default>1000</Default>
			<LowLimit>5</LowLimit>
			<HighLimit>2147483647</HighLimit>
			<Script>
				<Changed/>
			</Script>
			<Units>ms</Units>
		</Param>
		<Param OpName="i_conf" Caption="Config" Visible="false" OpIndex="0" Size="16" Instantiator="true" User="false" Type="Analog" ByteOrder="BigEndian" DataFormat="UnsignedInt">
			<Value>1</Value>
			<Default>1</Default>
			<LowLimit>1</LowLimit>
			<HighLimit>4</HighLimit>
			<Script>
				<Changed/>
			</Script>
		</Param>
		<Param OpName="SyncStatePins" Caption="SyncStatePins" Visible="false" OpIndex="-1" Size="1" Instantiator="false" User="true" Type="Discrete">
			<Value>0</Value>
			<Default>0</Default>
			<Script>
				<Changed>
					(function(videoItemFblElement, afbElement)
					{
						createSignals(videoItemFblElement, afbElement);
					})
				</Changed>
			</Script>
		</Param>
	</Params>
	<CommonScript>
		<Library>
			function createSignals(videoItemFblElement, afbElement)
			{
				videoItemFblElement.removeInputSignal("s_in");
				videoItemFblElement.removeOutputSignal("s_out");

				var show = videoItemFblElement.getParamBoolValue("SyncStatePins");
				if (show == true)
				{
					var s = afbElement.getAfbSignalByCaption("s_in");
					if (s != null)
					{
						videoItemFblElement.addInputSignal(s.jsCaption(), s.jsType(), s.operandIndex(), s.size());
					}

					s = afbElement.getAfbSignalByCaption("s_out");
					if (s != null)
					{
						videoItemFblElement.addOutputSignal(s.jsCaption(), s.jsType(), s.operandIndex(), s.size());
					}
				}

				videoItemFblElement.adjustHeight();
				return true;
			}
		</Library>
		<AfterCreation>
			(function(videoItemFblElement, afbElement)
			{
				createSignals(videoItemFblElement, afbElement);
			})
		</AfterCreation>
	</CommonScript>
</AFB>