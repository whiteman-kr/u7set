						createOutput(videoItemFblElement, afbElement, "OutUnderflow", "underflow");
						createOutput(videoItemFblElement, afbElement, "OutZero", "zero");
						createOutput(videoItemFblElement, afbElement, "OutNaN", "nan");

						videoItemFblElement.adjustHeight();
						return true;
					}

					function createSyncSignals(videoItemFblElement, afbElement)	{
						videoItemFblElement.removeInputSignal("s_in");

						var show = videoItemFblElement.getParamBoolValue("SyncStatePins");
						if (show == true) {
							var s = afbElement.getAfbSignalByCaption("s_in");
							if (s != null) {
								videoItemFblElement.addInputSignal(s.jsCaption(), s.jsType(), s.operandIndex(), s.size());
							}
						}

						videoItemFblElement.adjustHeight();
						return true;
					}
				</Library>
				<AfterCreation>
					(function(videoItemFblElement, afbElement) {
						createSyncSignals(videoItemFblElement, afbElement);
						createOutputSignals(videoItemFblElement, afbElement);
					})
