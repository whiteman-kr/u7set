#
# Runs after every "install()" command has completed
#

if(NOT WIN32)
    return()
endif()

# Helper file written by file(GENERATE) - defines ADSBRIDGE_DLL_NAME
#
include("${CMAKE_CURRENT_LIST_DIR}/../AdsBridge_vars.cmake")

set(BIN_DIR "${CMAKE_INSTALL_PREFIX}/bin")
set(DLL_PATH "${BIN_DIR}/${ADSBRIDGE_DLL_NAME}")   # installed copy!

# variables substituted by configure_file()
#
set(DLL_NAME       "@ADSBRIDGE_DLL_NAME@")
set(QT_BIN_DIR     "@Qt6_BIN_DIR@")
set(WINDEPLOYQT_EXE "@WINDEPLOYQT_EXE@")

# Run windeployqt on AdsBridge.dll
#
message(STATUS "[post-install] windeployqt -> ${DLL_PATH}")
execute_process(
    COMMAND  "${WINDEPLOYQT_EXE}"  "${DLL_PATH}"
    WORKING_DIRECTORY "${BIN_DIR}"
    RESULT_VARIABLE  _wdr
)
if(NOT _wdr EQUAL 0)
    message(WARNING "[post-install] windeployqt failed (exit ${_wdr})")
endif()
