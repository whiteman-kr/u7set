@PACKAGE_INIT@

include(${CMAKE_CURRENT_LIST_DIR}/AdsBridge_export.cmake)

check_required_components(AdsBridge)

# Copy DLLs to the target
#
if(NOT WIN32)
    return()
endif()

function(_adsbridge__inject_copy_steps ADS_BRIDGE_BIN_DIR)
    get_property(_all_tgts DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)

    foreach(_tgt IN LISTS _all_tgts)
        get_target_property(_libs1 "${_tgt}" LINK_LIBRARIES)
        get_target_property(_libs2 "${_tgt}" INTERFACE_LINK_LIBRARIES)
        list(APPEND _all_libs  ${_libs1}  ${_libs2})

        if("Radiy::AdsBridge" IN_LIST _all_libs)
            add_custom_command(
                TARGET  "${_tgt}" POST_BUILD

                # Make sure the destination exists.
                COMMAND "${CMAKE_COMMAND}" -E make_directory
                    "$<TARGET_FILE_DIR:${_tgt}>"

                # Recursively copy *only* changed files and directories.
                COMMAND "${CMAKE_COMMAND}" -E copy_directory_if_different
                    "${ADS_BRIDGE_BIN_DIR}"
                    "$<TARGET_FILE_DIR:${_tgt}>"

                COMMENT "AdsBridge: copying runtime files from ${ADS_BRIDGE_BIN_DIR} to $<TARGET_FILE_DIR:${_tgt}>"
                VERBATIM
            )
        endif()
    endforeach()
endfunction()

# Resolve to absolute path at configure time for robustness in the script
# Use REALPATH to resolve symlinks if necessary, BASE_DIR handles relative paths.
#
set(ADS_BRIDGE_BIN_DIR ${CMAKE_CURRENT_LIST_DIR}/../../../bin)
get_filename_component(ADS_BRIDGE_BIN_DIR_ABS "${ADS_BRIDGE_BIN_DIR}" REALPATH BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")

cmake_language(
    DEFER
    DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
    CALL _adsbridge__inject_copy_steps "${ADS_BRIDGE_BIN_DIR}"
)