<?xml version="1.0" encoding="UTF-8"?>
<project version="1">
    <builddir>../u7set-cppcheck-build-dir</builddir>
    <analyze-all-vs-configs>false</analyze-all-vs-configs>
    <check-headers>true</check-headers>
    <check-unused-templates>true</check-unused-templates>
    <max-ctu-depth>2</max-ctu-depth>
    <max-template-recursion>100</max-template-recursion>
    <includedir>
        <dir name="lib/"/>
    </includedir>
    <defines>
        <define name="COMMON_LIB_DOMAIN"/>
        <define name="UTILS_LIB_DOMAIN"/>
        <define name="HARDWARE_LIB_DOMAIN"/>
        <define name="ONLINE_LIB_DOMAIN"/>
        <define name="APP_SIGNAL_LIB_DOMAIN"/>
        <define name="DB_LIB_DOMAIN"/>
        <define name="SERVICE_LIB_DOMAIN"/>
        <define name="CLIENT_LIB_DOMAIN"/>
        <define name="PROTOBUF_VERSION=3015000"/>
        <define name="PROTOBUF_NAMESPACE_OPEN=namespace google{namespace protobuf{"/>
        <define name="PROTOBUF_NAMESPACE_CLOSE=}}"/>
        <define name="PROTOBUF_DEPRECATED_MSG=void()"/>
    </defines>
    <paths>
        <dir name="CommonLib"/>
        <dir name="UtilsLib"/>
        <dir name="DbLib"/>
        <dir name="Protobuf"/>
        <dir name="HardwareLib"/>
        <dir name="OnlineLib"/>
        <dir name="AppSignalLib"/>
        <dir name="ServiceLib"/>
        <dir name="ClientLib"/>
        <dir name="TrendView"/>
        <dir name="VFrame30"/>
        <dir name="Builder"/>
        <dir name="BuilderConsole"/>
        <dir name="Simulator"/>
        <dir name="SimulatorConsole"/>
        <dir name="AppDataService"/>
        <dir name="ConfigurationService"/>
        <dir name="ArchivingService"/>
        <dir name="TuningService"/>
        <dir name="ReportLib"/>
        <dir name="GatewayService"/>
        <dir name="lib"/>
        <dir name="mconf"/>
        <dir name="Metrology"/>
        <dir name="Monitor"/>
        <dir name="TestSuite"/>
        <dir name="TestSuiteConsole"/>
        <dir name="TuningClient"/>
        <dir name="u7"/>
    </paths>
    <exclude>
        <path name="Protobuf/google/"/>
        <path name="D:/Develop/u7set.dev/Proto/*.pb.h"/>
        <path name="D:/Develop/u7set.dev/Proto/*.pb.cc"/>
        <path name="ServiceLib/qtservice/"/>
        <path name="asio/"/>
        <path name="D:/Develop/u7set.dev/AppDataService/TcpAppDataServer.cpp"/>
        <path name="D:/Develop/u7set.dev/asio/include/asio/cancellation_state.hpp"/>
        <path name="D:/Develop/u7set.dev/AppDataService/SignalStatesProcessingThread.cpp"/>
    </exclude>
    <libraries>
        <library>qt</library>
        <library>windows</library>
    </libraries>
    <suppressions>
        <suppression>unusedFunction</suppression>
        <suppression>noExplicitConstructor</suppression>
        <suppression>assertWithSideEffect</suppression>
    </suppressions>
    <project-name>u7set</project-name>
</project>
